[Unit]
Description=secretdrop — one-time secret handoff over Tailscale
# A --user unit cannot order itself against the system tailscaled.service, and
# even where it could, a running daemon does not mean the tailnet address has
# been handed out yet. These are a hint; the real wait is in the server, which
# polls for the address and exits non-zero if it never comes.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m secretdrop serve
WorkingDirectory=%h
Environment=PYTHONUNBUFFERED=1
# systemd --user gives a minimal PATH; add wherever your callback's tools live.
Environment=PATH=%h/.npm-global/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SECRETDROP_CONFIG=%h/.config/secretdrop/config.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=%h/.local/state/secretdrop %h/.openclaw

[Install]
WantedBy=default.target
